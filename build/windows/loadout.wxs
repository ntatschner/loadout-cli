<?xml version="1.0" encoding="utf-8"?>

<!--
  The Windows installer (spec sections 18 to 20).

  Per-user by default, and that is a deliberate choice rather than a default
  taken. loadout manages one person's projects, credentials and workspace
  clone; installing it for the whole machine would put a tool that reads a
  user's Keychain-equivalent into a location every account shares, and would
  demand an elevation prompt for something that needs none.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="Loadout"
           Manufacturer="Loadout"
           Version="$(var.Version)"
           UpgradeCode="b3cb085d-bc14-5901-ad7d-a4f6e3bae121"
           Scope="perUser"
           Compressed="yes">

    <!--
      Older versions are removed before the new files are laid down. The
      alternative, removing afterwards, deletes files the new version just
      wrote when the two share a name, which is every file here.
    -->
    <!--
      A new upgrade code, because this is a different product identity from the
      one that shipped under the previous name. An installation of that one is
      not upgraded in place: it is a separate entry that can be removed on its
      own terms, which is honest about what happened rather than pretending the
      two were always the same thing.
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Loadout is already installed." />

    <!--
      Whether closing the launcher would end somebody's session.

      A session runs inside the launcher process: the agent inherits its
      terminal, so the launcher stays alive for as long as the session does and
      is its parent. Which means the action below, which closes every launcher
      so the binary can be replaced, ends live sessions — the very thing its own
      comment sets out to protect. It spares the process tree beneath a
      launcher and then kills the launcher the session is inside.

      Nothing here can read the session records to find out: they are one file
      per session and answering "is any of them still alive" means checking a
      process, which is code, and an immediate action that could run code is the
      thing this file already established cannot be scheduled in time. What MSI
      can do unaided is look for a file with a known name, so the launcher keeps
      one that exists for exactly as long as a session is running.

      Refused rather than closed, when one is found. There is no third option:
      Windows will not replace a running image, so either the session dies or
      the install stops, and only one of those is somebody's work.
    -->
    <Property Id="LOADOUTSESSIONRUNNING">
      <DirectorySearch Id="LoadoutLocalRoot" Path="[LocalAppDataFolder]Loadout">
        <DirectorySearch Id="LoadoutLaunches" Path="launches">
          <DirectorySearch Id="LoadoutRunning" Path="running">
            <FileSearch Id="LoadoutInProgress" Name="in-progress" />
          </DirectorySearch>
        </DirectorySearch>
      </DirectorySearch>
    </Property>

    <!--
      Evaluated by LaunchConditions, which runs after AppSearch has set the
      property above and before InstallValidate reaches the file-in-use dialog,
      so this is said instead of that dialog rather than after it.
    -->
    <Launch Condition="NOT LOADOUTSESSIONRUNNING"
            Message="Loadout is running an agent session. Installing now would close the launcher that session is running inside and end it. Close your Loadout sessions and run this installer again." />

    <!--
      The launcher is closed before its own file is replaced.

      Windows normally does this itself. The Restart Manager notices which
      process holds a file the installer needs, closes it, and starts it again
      afterwards. But it can be switched off machine-wide, and on a managed or
      hardened Windows build it often is:

        HKLM\SOFTWARE\Policies\Microsoft\Windows\Installer
          DisableAutomaticApplicationShutdown = 1

      With that set the install log reads "RESTART MANAGER: Disabled by
      DisableAutomaticApplicationShutdown system policy; Windows Installer will
      use the built-in FilesInUse functionality", and that fallback is a dialog
      offering Retry or Cancel. Retry can never succeed, because nothing closed
      the process in between, so the install ends in 1603 — which from outside
      is indistinguishable from the installer crashing.

      Upgrading is exactly when the launcher is most likely to be open, because
      the launcher is the thing somebody sits in. So it is closed here rather
      than asked about.

      Why this and not util:CloseApplication, which exists for the purpose: it
      works in two halves, an immediate action that schedules a deferred one to
      do the closing. Deferred actions can only be scheduled once the install
      script exists, which is after InstallInitialize. But the dialog above
      comes from InstallValidate, which runs before InstallInitialize, so any
      action that has to be reached after InstallInitialize is already too
      late. Scheduling it early instead only moves the failure:

        WixCloseApplications: Error 0x80070643: failed to schedule
        CloseApplicationsDeferred action

      Closing the launcher therefore has to happen in a single immediate
      action, which is what this is.

      Killed rather than asked to close, because a console program owns no
      window to send WM_CLOSE to. Nothing is lost by it: settings are written
      when they are changed, not when the launcher exits. Only this user's
      processes are matched, and the action deliberately does not touch the
      process tree — an agent the launcher started is somebody's running
      session, and an installer has no business ending it.
    -->
    <StandardDirectory Id="System64Folder" />

    <!--
      Run through WixQuietExec rather than as a plain ExeCommand, which is
      purely about what the person installing has to look at.

      msiexec has no console of its own, so starting a console program from it
      makes Windows create one, and taskkill is a console program: a black
      window appears and disappears in the middle of the install. An upgrade
      shows it twice, because the version being replaced runs its own copy of
      this action on the way out. WixQuietExec starts the process with
      CREATE_NO_WINDOW and captures its output into the MSI log instead, which
      is the same work with nothing to see.
    -->
    <SetProperty Id="WixQuietExecCmdLine"
                 Value="&quot;[System64Folder]taskkill.exe&quot; /F /IM loadout.exe"
                 Before="CloseRunningLoadout"
                 Sequence="execute" />

    <CustomAction Id="CloseRunningLoadout"
                  DllEntry="WixQuietExec"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <!--
      Return="ignore" because "no such process" is the ordinary case: taskkill
      exits 128 when the launcher was not running, and that must not fail an
      install that had nothing to close. QuietExec turns a non-zero exit into a
      failed action, so this attribute is doing more work here than it was
      before, when the exit code was ignored anyway.
    -->
    <InstallExecuteSequence>
      <!--
        Conditioned as well as guarded by the launch condition above. The
        condition already stops the install, but a kill that would end a
        session should not be one line of sequencing away from running anyway.
      -->
      <Custom Action="CloseRunningLoadout"
              Before="InstallValidate"
              Condition="NOT LOADOUTSESSIONRUNNING" />
    </InstallExecuteSequence>

    <MediaTemplate EmbedCab="yes" />

    <!--
      Under Programs, not beside the launcher's own data directory. They share a
      parent otherwise, and an uninstall that tidied up its install root a
      little too enthusiastically would take somebody's workspace clone,
      credentials mapping and backup sets with it. Keeping the two apart means
      that mistake is not available to make.
    -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="loadout">
          <Directory Id="BINFOLDER" Name="bin" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="loadout" />
    </StandardDirectory>

    <Feature Id="Main" Title="loadout" Level="1">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="PathEntry" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!--
      The published output is harvested rather than listed. A self-contained
      .NET publish is a hundred-odd files whose names change with the runtime
      version, and a hand-written manifest would be wrong by the next upgrade.
    -->
    <ComponentGroup Id="Payload" Directory="BINFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <Component Id="PathEntry" Directory="BINFOLDER" Guid="51beb1d8-bbf7-595c-b97c-e02701dcde51">
      <!--
        On PATH because a launcher nobody can type the name of is not much use.
        Per-user, matching the install scope, so it needs no elevation and
        cannot affect anyone else's shell.
      -->
      <Environment Id="LoadoutPath"
                   Name="PATH"
                   Value="[BINFOLDER]"
                   Permanent="no"
                   Part="last"
                   Action="set"
                   System="no" />

      <RegistryValue Root="HKCU"
                     Key="Software\Loadout"
                     Name="InstalledPath"
                     Type="string"
                     Value="[BINFOLDER]"
                     KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut"
               Directory="ApplicationProgramsFolder"
               Guid="9c10030a-eabf-5fd1-9ba7-4f87f2f3263f">

      <Shortcut Id="LoadoutShortcut"
                Name="loadout"
                Description="Loadout"
                Target="[BINFOLDER]loadout.exe"
                WorkingDirectory="BINFOLDER"
                Icon="loadout.ico" />

      <RemoveFolder Id="RemoveProgramsFolder" On="uninstall" />

      <RegistryValue Root="HKCU"
                     Key="Software\Loadout"
                     Name="StartMenu"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- The Start Menu shortcut and the Add/Remove Programs entry read this
         rather than the executable, so without it both showed a generic icon
         even once the binary had one of its own. -->
    <Icon Id="loadout.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="loadout.ico" />

  </Package>
</Wix>
