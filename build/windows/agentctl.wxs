<?xml version="1.0" encoding="utf-8"?>

<!--
  The Windows installer (spec sections 18 to 20).

  Per-user by default, and that is a deliberate choice rather than a default
  taken. agentctl manages one person's projects, credentials and workspace
  clone; installing it for the whole machine would put a tool that reads a
  user's Keychain-equivalent into a location every account shares, and would
  demand an elevation prompt for something that needs none.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="agentctl"
           Manufacturer="Agent Workspace Launcher"
           Version="$(var.Version)"
           UpgradeCode="7a1f6a52-4e2d-4f8b-9c31-5b0d2e7a9f14"
           Scope="perUser"
           Compressed="yes">

    <!--
      Older versions are removed before the new files are laid down. The
      alternative, removing afterwards, deletes files the new version just
      wrote when the two share a name, which is every file here.
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of agentctl is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!--
      Under Programs, not beside the launcher's own data directory. They share a
      parent otherwise, and an uninstall that tidied up its install root a
      little too enthusiastically would take somebody's workspace clone,
      credentials mapping and backup sets with it. Keeping the two apart means
      that mistake is not available to make.
    -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="agentctl">
          <Directory Id="BINFOLDER" Name="bin" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="agentctl" />
    </StandardDirectory>

    <Feature Id="Main" Title="agentctl" Level="1">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="PathEntry" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!--
      The published output is harvested rather than listed. A self-contained
      .NET publish is a hundred-odd files whose names change with the runtime
      version, and a hand-written manifest would be wrong by the next upgrade.
    -->
    <ComponentGroup Id="Payload" Directory="BINFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <Component Id="PathEntry" Directory="BINFOLDER" Guid="c4e8b1d0-2f37-4a56-8e9c-1d3b5a7f0c62">
      <!--
        On PATH because a launcher nobody can type the name of is not much use.
        Per-user, matching the install scope, so it needs no elevation and
        cannot affect anyone else's shell.
      -->
      <Environment Id="AgentctlPath"
                   Name="PATH"
                   Value="[BINFOLDER]"
                   Permanent="no"
                   Part="last"
                   Action="set"
                   System="no" />

      <RegistryValue Root="HKCU"
                     Key="Software\AgentWorkspaceLauncher"
                     Name="InstalledPath"
                     Type="string"
                     Value="[BINFOLDER]"
                     KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut"
               Directory="ApplicationProgramsFolder"
               Guid="9b2d7c41-6a58-4e93-bf12-8c04d6e5a37b">

      <Shortcut Id="AgentctlShortcut"
                Name="agentctl"
                Description="Agent Workspace Launcher"
                Target="[BINFOLDER]agentctl.exe"
                WorkingDirectory="BINFOLDER" />

      <RemoveFolder Id="RemoveProgramsFolder" On="uninstall" />

      <RegistryValue Root="HKCU"
                     Key="Software\AgentWorkspaceLauncher"
                     Name="StartMenu"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

  </Package>
</Wix>
