<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <!-- Core references the platform ABSTRACTIONS only. It must never take a
         dependency on a concrete platform implementation; ArchitectureTests
         asserts no `Loadout.Platform.Windows/Linux/MacOS` namespace is
         referenced from Core. -->
    <ProjectReference Include="..\Loadout.Models\Loadout.Models.csproj" />
    <ProjectReference Include="..\Loadout.Platform\Loadout.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The built-in specialist library travels inside the assembly rather
         than beside it. Content that is not on a disk cannot be edited in
         place, cannot go missing from an install, and cannot be pointed
         somewhere else — three classes of problem that simply do not arise.
         Somebody who disagrees with a built-in specialist puts one of the same
         id in their workspace, which is the supported way to override. -->
    <EmbeddedResource Include="Specialists\**\*.md" />

    <!-- The built-in teams travel the same way, for the same reasons. -->
    <EmbeddedResource Include="Teams\Catalogue\*.yaml" />
    <EmbeddedResource Include="Teams\Capabilities\*.yaml" />

    <!-- And the dashboard page, so it cannot go missing from an install and
         cannot be edited into something that fetches from the internet. It is
         one file with no assets for the same reason: a dashboard that pulled a
         stylesheet from somewhere would not work on the machine it is most
         wanted on, which is one with no network. -->
    <EmbeddedResource Include="Teams\Daemon\dashboard.html" />

    <!-- The office Loadout ships, made for it, so it is Loadout's to give away
         rather than an asset pack's. Unpacked into the office folder at start
         (OfficeArt.Unpack), where everything that reads a set finds it. -->
    <EmbeddedResource Include="Teams\Office\loadout-tech\*" LogicalName="office/loadout-tech/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Loadout.Tests" />
  </ItemGroup>

  <!-- Studio, the app the daemon serves, built from src/Loadout.Studio with
       Node and embedded under studio/. StudioBuild is auto (build it where
       Node is installed, leave it out where it is not), false (leave it out)
       or required (fail without it, as a release does). Leaving it out costs
       nothing but the page: /studio/ says it was not built in, and every
       test of the API it calls runs without it. -->
  <PropertyGroup>
    <StudioRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Loadout.Studio'))\</StudioRoot>
    <StudioBuild Condition="'$(StudioBuild)' == ''">auto</StudioBuild>
  </PropertyGroup>

  <ItemGroup>
    <StudioSource Include="$(StudioRoot)src\**\*;$(StudioRoot)public\**\*;$(StudioRoot)index.html;$(StudioRoot)vite.config.js;$(StudioRoot)package-lock.json" />
  </ItemGroup>

  <Target Name="StudioProbe" Condition="'$(StudioBuild)' != 'false'">
    <Exec Command="node --version" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ExitCode" PropertyName="_StudioNodeExit" />
    </Exec>
    <Error Condition="'$(_StudioNodeExit)' != '0' And '$(StudioBuild)' == 'required'" Text="Studio has to be built into this build, and Node is not installed. Install Node 22.12 or later." />
    <Message Condition="'$(_StudioNodeExit)' != '0'" Importance="high" Text="Node is not installed, so this build leaves Studio out. /studio/ will say so." />
  </Target>

  <Target Name="StudioInstall" Condition="'$(StudioBuild)' != 'false' And '$(_StudioNodeExit)' == '0' And !Exists('$(StudioRoot)node_modules\.package-lock.json')">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(StudioRoot)" />
  </Target>

  <Target Name="StudioBundle" Condition="'$(StudioBuild)' != 'false' And '$(_StudioNodeExit)' == '0'" Inputs="@(StudioSource)" Outputs="$(StudioRoot)dist\index.html">
    <Exec Command="npm run build --silent" WorkingDirectory="$(StudioRoot)" />
  </Target>

  <Target Name="StudioEmbed" BeforeTargets="BeforeBuild" DependsOnTargets="StudioProbe;StudioInstall;StudioBundle" Condition="'$(StudioBuild)' != 'false'">
    <!-- Through an item of its own, because metadata named bare inside a
         target batches over the EmbeddedResource items already there and
         adds nothing. -->
    <ItemGroup Condition="'$(_StudioNodeExit)' == '0'">
      <StudioFile Include="$(StudioRoot)dist\**\*" />
      <EmbeddedResource Include="@(StudioFile)" LogicalName="studio/%(StudioFile.RecursiveDir)%(StudioFile.Filename)%(StudioFile.Extension)" />
    </ItemGroup>
  </Target>
</Project>
