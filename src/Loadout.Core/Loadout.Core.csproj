<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <!-- Core references the platform ABSTRACTIONS only. It must never take a
         dependency on a concrete platform implementation; ArchitectureTests
         asserts no `Loadout.Platform.Windows/Linux/MacOS` namespace is
         referenced from Core. -->
    <ProjectReference Include="..\Loadout.Models\Loadout.Models.csproj" />
    <ProjectReference Include="..\Loadout.Platform\Loadout.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The built-in specialist library travels inside the assembly rather
         than beside it. Content that is not on a disk cannot be edited in
         place, cannot go missing from an install, and cannot be pointed
         somewhere else — three classes of problem that simply do not arise.
         Somebody who disagrees with a built-in specialist puts one of the same
         id in their workspace, which is the supported way to override. -->
    <EmbeddedResource Include="Specialists\**\*.md" />

    <!-- The built-in teams travel the same way, for the same reasons. -->
    <EmbeddedResource Include="Teams\Catalogue\*.yaml" />

    <!-- And the dashboard page, so it cannot go missing from an install and
         cannot be edited into something that fetches from the internet. It is
         one file with no assets for the same reason: a dashboard that pulled a
         stylesheet from somewhere would not work on the machine it is most
         wanted on, which is one with no network. -->
    <EmbeddedResource Include="Teams\Daemon\dashboard.html" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Loadout.Tests" />
  </ItemGroup>
</Project>
