<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>loadout</AssemblyName>
    <RootNamespace>Loadout.Cli</RootNamespace>
    <!-- Self-contained single-file per spec 7. Trimming and NativeAOT stay off:
         YamlDotNet's reflection-based deserialisation does not survive them. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.51.*" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.51.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Loadout.Tui\Loadout.Tui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Loadout.Tests" />
  </ItemGroup>
</Project>
