<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>loadout</AssemblyName>
    <RootNamespace>Loadout.Cli</RootNamespace>

    <!-- Gives the executable itself an icon, which is what Explorer, the
         taskbar and any shortcut somebody makes by hand all read. -->
    <ApplicationIcon>../../build/icon/loadout.ico</ApplicationIcon>
    <!-- Trimming and NativeAOT stay off: YamlDotNet's reflection-based
         deserialisation does not survive them.

         Self-contained single-file publishing per spec 7 is asked for by the
         build scripts rather than declared here. Declaring it made every
         ordinary build a self-contained one, which forces a runtime identifier
         and moves the output into bin/<config>/net10.0/<rid>/. "dotnet test"
         does not refresh that copy, so the tests that run the built command
         line were executing whatever an earlier build had left there — passing
         or failing against source nobody was looking at any more. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Loadout.Tui\Loadout.Tui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Loadout.Tests" />
  </ItemGroup>
</Project>
