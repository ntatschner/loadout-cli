<Project>

  <PropertyGroup>
    <!-- Tier-1 parity depends on this staying OS-neutral. A `net10.0-windows`
         TFM anywhere in the tree breaks the Linux and macOS builds outright,
         so the TFM is set once, here, and never overridden per project.
         ArchitectureTests asserts that. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Globalization stays enabled. In invariant mode string.Normalize is a
         no-op, which silently defeats the NFD/NFC path handling that spec
         section 84 requires on macOS, and the launcher deals in user-chosen
         directory names in arbitrary languages. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- CA1416 (platform compatibility) is the analyser that enforces the
         cross-platform contract at compile time rather than at CI time. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Records the exact package versions a restore resolved, so a release
         can be rebuilt from its commit rather than from whatever NuGet was
         serving that day. Warnings are errors here, which means a floated
         dependency could also break the build with no commit behind it; the
         lock file is what stops that happening unannounced. See
         Directory.Packages.props. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- The six runtimes a release publishes, declared so the lock file covers
         them. A lock file written without a runtime identifier does not
         describe a self-contained publish, and restoring one in locked mode
         fails with NU1004 the moment a release is built. Locking the ordinary
         build while leaving the release build unlocked would have protected
         the wrong one. -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Product>Loadout</Product>
    <Company>TheCodeSaiyan Ltd</Company>
    <Copyright>Copyright (c) 2026 TheCodeSaiyan Ltd</Copyright>
    <Version>0.9.7</Version>

    <!-- Declared on the assemblies themselves so the licence travels with the
         binary. build/licences.ps1 checks that every dependency can be shipped
         under it. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
